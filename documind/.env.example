# Copy to .env and fill in real values. Never commit .env.

# Database (matches docker-compose.yml defaults — override for non-Docker runs)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/documind

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# LLM provider selection
# Active default is "groq" (LLM via Groq, embeddings via VoyageAI).
# Switch to "gemini" or "openai" by changing LLM_PROVIDER and filling in that
# provider's keys below. The embedder follows the same provider switch.
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Groq (active default) ---
GROQ_API_KEY=
GROQ_MODEL=groq/compound

# --- VoyageAI (active embeddings for the groq provider) ---
VOYAGEAI_API_KEY=
VOYAGEAI_EMBEDDING_MODEL=voyage-4-lite

# --- Gemini (set LLM_PROVIDER=gemini to use) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (set LLM_PROVIDER=openai to use) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding vector dimension stored in pgvector. Must match db/models.py
# EMBEDDING_DIM and the dimension emitted by the active embedding model.
# Current value matches the pgvector column (Vector(512)).
EMBEDDING_DIM=512

# Rerank (Cohere — used by the rerank agent node regardless of LLM_PROVIDER)
COHERE_API_KEY=

# LangSmith (optional in dev, required for Step 8 analysis)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documind
LANGSMITH_TRACING=false
