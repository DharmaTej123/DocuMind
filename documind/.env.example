# Copy to .env and fill in real values. Never commit .env.

# Database (matches docker-compose.yml defaults — override for non-Docker runs)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/documind

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# LLM provider selection
# Active default is "groq" (LLM via Groq, embeddings via VoyageAI).
# Switch to "gemini" or "openai" by changing LLM_PROVIDER and filling in that
# provider's keys below. The embedder follows the same provider switch.
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Groq (active default) ---
# GROQ_API_KEY=
# GROQ_MODEL=groq/compound

# --- VoyageAI (active embeddings for the groq provider) ---
VOYAGEAI_API_KEY=
VOYAGEAI_EMBEDDING_MODEL=voyage-4-lite

# --- Anthropic (set LLM_PROVIDER=anthropic to use; embeddings use VoyageAI above) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Gemini (set LLM_PROVIDER=gemini to use) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (set LLM_PROVIDER=openai to use) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding vector dimension stored in pgvector. Must match db/models.py
# EMBEDDING_DIM and the dimension emitted by the active embedding model.
# Current value matches the pgvector column (Vector(512)).
EMBEDDING_DIM=512

# Vector store: "pgvector" (default) or "chroma" (TEMPORARY local alternative).
# Existing pgvector data is NOT migrated: re-upload documents after switching
# stores (in either direction). Relational data (users, documents) stays in Postgres.
VECTOR_STORE=pgvector
# Directory for Chroma's persistent local data (only used when VECTOR_STORE=chroma).
CHROMA_PATH=./chroma_data

# Hybrid retrieval: fuse vector search with BM25 keyword search (exact names and
# numbers). Works with either vector store. Set false for vector-only.
HYBRID_SEARCH=true

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# One extra LLM call per upload extracts document-level metadata (subject, kind,
# topics) that is added to every chunk. Set false to use the filename only.
EXTRACT_DOC_METADATA=true

# Earlier question/answer pairs of the same conversation shown to the model for
# follow-up questions (0 = no memory).
HISTORY_TURNS=4

# Optional: answer "not found" without an LLM call when the best rerank score is
# below this. 0 = off. Tune using RERANK_DEBUG output; Cohere scores are not probabilities.
ANSWER_MIN_RERANK_SCORE=0

# Rerank (Cohere — used by the rerank agent node regardless of LLM_PROVIDER)
COHERE_API_KEY=

# LangSmith (optional in dev, required for Step 8 analysis)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documind
LANGSMITH_TRACING=false
